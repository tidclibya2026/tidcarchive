# انسخ هذا الملف إلى /etc/tidc-archive/backup.env ثم استبدل القيم داخل الخادم فقط.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=tidc-archive
BACKUP_ROOT=/var/backups/tidc-archive
BACKUP_GPG_RECIPIENT=
OFFSITE_RCLONE_REMOTE=
RETENTION_DAYS=90
ALLOW_RESTORE_TEST=no
RESTORE_DB_HOST=
RESTORE_DB_PORT=3306
RESTORE_DB_USER=
RESTORE_TEST_DATABASE=
RESTORE_TEST_BUCKET=
